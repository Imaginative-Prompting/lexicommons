{
  "name": "lexicommons",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run typecheck && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply lexicommons --remote",
    "db:migrate:local": "wrangler d1 migrations apply lexicommons --local"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.3.1",
    "@simplewebauthn/server": "^14.0.3",
    "agents": "^0.30.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@simplewebauthn/browser": "^14.0.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
